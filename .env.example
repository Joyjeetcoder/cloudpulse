# Copy to .env at the cloudpulse repository root. NEVER commit .env.
# Generate two DIFFERENT values with: python scripts/make_secrets.py
GITHUB_WEBHOOK_SECRET=replace-with-first-random-value
DASHBOARD_TOKEN=replace-with-second-random-value

# Fine-grained PAT, selected test repository, Actions: read-only.
GITHUB_TOKEN=replace-with-your-github-token
GITHUB_REPOSITORIES=YOUR_GITHUB_USERNAME/cloudpulse-test-app

# Create in Google AI Studio. Keep it on the server, never in frontend code.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Change this to a text model ID enabled for your AI Studio project if necessary.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=90

MAX_EXCERPT_CHARS=14000
MAX_FAILED_JOBS=5
MAX_JOB_LOG_BYTES=5000000
MAX_ANALYSIS_ATTEMPTS=3

# These local paths are overridden to /data and /app/static in Docker.
DATA_DIR=./data
FRONTEND_DIR=./frontend/dist
